rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if admin() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.adminNote == resource.data.adminNote &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.description == resource.data.description
      );
      allow delete: if false;
    }
  }
}
